diff --git a/external/nss/nspr-pr-abspath.patch.1 b/external/nss/nspr-pr-abspath.patch.1
new file mode 100644
index 000000000..7bfb8d653
--- /dev/null
+++ b/external/nss/nspr-pr-abspath.patch.1
@@ -0,0 +1,17 @@
+GoOffice: on the msys2-based CI host the $(shell cygpath -m ...) calls inside
+pr_abspath (added by nss.windows.patch, which assumes Git Bash) get mangled by
+the msys shell eating backslashes, so cl receives "D:a:/_temp/..." and dies
+with C1083 on now.c. Resolve relative sources with GNU make's own $(abspath)
+instead - no shell, no cygpath.
+
+--- a/nspr/config/rules.mk
++++ b/nspr/config/rules.mk
+@@ -406,7 +406,7 @@
+
+ ifdef NEED_ABSOLUTE_PATH
+ # The quotes allow absolute paths to contain spaces.
+-pr_abspath = "$(if $(findstring :,$(1)),$(1),$(if $(filter /%,$(shell cygpath -m $(1))),$(1),$(shell cygpath -m $(CURDIR)/$(1))))"
++pr_abspath = "$(if $(findstring :,$(1)),$(1),$(if $(filter /%,$(1)),$(shell cygpath -m $(1)),$(abspath $(1))))"
+ endif
+ 
+ $(OBJDIR)/%.$(OBJ_SUFFIX): %.cpp
