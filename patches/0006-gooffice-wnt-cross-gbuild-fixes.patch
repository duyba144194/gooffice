diff --git a/configure.ac b/configure.ac
index 4641ba734..9e8624a08 100644
--- a/configure.ac
+++ b/configure.ac
@@ -6280,7 +6280,14 @@ if test "$cross_compiling" = "yes"; then
     sub_conf_opts=""
     test -n "$enable_ccache" && sub_conf_opts="$sub_conf_opts --enable-ccache=$enable_ccache"
     test -n "$with_ant_home" && sub_conf_opts="$sub_conf_opts --with-ant-home=$with_ant_home"
+    dnl GoOffice patch: forward the junit jar too, the build side cannot
+    dnl find it on its own in wsl-as-helper mode
+    test -n "$with_junit" && test "$with_junit" != "no" && sub_conf_opts="$sub_conf_opts --with-junit=$with_junit"
     test "$with_junit" = "no" && sub_conf_opts="$sub_conf_opts --without-junit"
+    dnl GoOffice patch: the BUILD-side configure runs in wsl-as-helper mode too
+    dnl and then requires the strawberry-perl option, so forward it
+    test -n "$with_strawberry_perl_portable" && sub_conf_opts="$sub_conf_opts --with-strawberry-perl-portable=$with_strawberry_perl_portable"
+    test -n "$with_doxygen" && test "$with_doxygen" != "yes" && sub_conf_opts="$sub_conf_opts --with-doxygen=$with_doxygen"
     # While we don't need scripting support, we don't have a PYTHON_FOR_BUILD Java equivalent, so must enable scripting for Java
     if test -n "$ENABLE_JAVA"; then
         case "$_os" in
@@ -6292,6 +6299,9 @@ if test "$cross_compiling" = "yes"; then
             if test -z "$with_jdk_home"; then
                 AC_MSG_ERROR([Missing host JDK! This can't be detected for the build OS, so you have to specify it with --with-jdk-home.])
             fi
+            dnl GoOffice patch: the BUILD-side configure needs a JDK too and
+            dnl cannot detect it in wsl-as-helper mode, so forward the host one
+            test -n "$with_jdk_home" && sub_conf_opts="$sub_conf_opts --with-jdk-home=$with_jdk_home"
             ;;
         esac
     else
@@ -6320,8 +6330,24 @@ if test "$cross_compiling" = "yes"; then
 
     # Don't bother having configure look for stuff not needed for the build platform anyway
     # WARNING: any option with an argument containing spaces must be handled separately (see --with-theme)
+    dnl GoOffice patch: for wsl-as-helper builds the BUILD side is Windows
+    dnl (cygwin), not the WSL kernel - without this the sub configure detects
+    dnl an x86_64-pc-linux-gnu host and demands Linux-only system libraries
+    build_side_host=""
+    if test -n "$WSL_ONLY_AS_HELPER"; then
+        build_side_host="--host=$build_cpu-pc-cygwin"
+        dnl the WSL ccache is invisible to the Windows-side make that runs
+        dnl the build tools, so keep ccache off on the build side too
+        sub_conf_opts="$sub_conf_opts --disable-ccache"
+        dnl finding Windows system-python headers from WSL does not work;
+        dnl give the build side the same bundled python as the host
+        if test -n "$enable_python" -a "$enable_python" != "no"; then
+            sub_conf_opts="$sub_conf_opts --enable-python=$enable_python"
+        fi
+    fi
     sub_conf_defaults=" \
         --build="$build_alias" \
+        $build_side_host \
         --disable-cairo-canvas \
         --disable-cups \
         --disable-customtarget-components \
@@ -6480,7 +6506,10 @@ if test "$cross_compiling" = "yes"; then
     BUILD_PATH=$PATH
     PATH=$OLD_PATH
 
-    line=`echo "LO_PATH_FOR_BUILD='${BUILD_PATH}'" | sed -e 's,/CONF-FOR-BUILD,,g'`
+    dnl GoOffice patch: on Windows the 8.3 alias CONF-F~1 may appear instead
+    dnl of CONF-FOR-BUILD; normalize before stripping so the build-side
+    dnl paths point at the top build dir like the non-short case does
+    line=`echo "LO_PATH_FOR_BUILD='${BUILD_PATH}'" | sed -e 's,/CONF-F~[0-9],/CONF-FOR-BUILD,g' -e 's,/CONF-FOR-BUILD,,g'`
     echo "$line" >>build-config
 
     for V in $DIRECT_FOR_BUILD_SETTINGS; do
@@ -6504,7 +6533,7 @@ if test "$cross_compiling" = "yes"; then
     for V in INSTDIR INSTROOT WORKDIR; do
         VV='$'$V
         VV=`eval "echo $VV"`
-        VV=`echo $VV | sed -e "s,/CONF-FOR-BUILD/\([[a-z]]*\),/\1_for_build,g"`
+        VV=`echo $VV | sed -e "s,/CONF-F~[0-9]/\([[a-z]]*\),/CONF-FOR-BUILD/\1,g" -e "s,/CONF-FOR-BUILD/\([[a-z]]*\),/\1_for_build,g"`
         if test -n "$VV"; then
             line="${V}_FOR_BUILD='$VV'"
             echo "$line" >>build-config
@@ -6514,7 +6543,8 @@ if test "$cross_compiling" = "yes"; then
     )
     test -f CONF-FOR-BUILD/build-config || AC_MSG_ERROR([setup/configure for BUILD side failed, see CONF-FOR-BUILD/config.log])
     test -f config_build.mk || AC_MSG_ERROR([A file called config_build.mk was supposed to have been copied here, but it isn't found])
-    perl -pi -e 's,/(workdir|instdir)(/|$),/\1_for_build\2,g;' \
+    perl -pi -e 's,/CONF-F~\d,/CONF-FOR-BUILD,g;' \
+             -e 's,/(workdir|instdir)(/|$),/\1_for_build\2,g;' \
              -e 's,/CONF-FOR-BUILD,,g;' config_build.mk
 
     eval `cat CONF-FOR-BUILD/build-config`
@@ -15583,14 +15613,31 @@ if test -z "$with_branding" -o "$with_branding" = "no"; then
     AC_MSG_RESULT([none])
     DEFAULT_BRAND_IMAGES="$brand_files"
 else
-    if ! test -d $with_branding ; then
+    dnl GoOffice patch: make the branding path WSL-as-helper aware. configure
+    dnl runs inside WSL while make runs natively on Windows, so test paths in
+    dnl WSL form but store a Windows path (mixed mode) in config_host.mk.
+    branding_dir_unix="$with_branding"
+    branding_dir_win="$with_branding"
+    if test -n "$WSL_ONLY_AS_HELPER"; then
+        dnl wsl-as-helper: tests run in WSL, make runs natively on Windows
+        case "$with_branding" in
+        [[A-Za-z]]:[[\\/]]*)
+            _bp=$(wslpath -u "$with_branding" 2>/dev/null) && test -n "$_bp" && branding_dir_unix="$_bp"
+            _bp=$(wslpath -m "$branding_dir_unix" 2>/dev/null) && test -n "$_bp" && branding_dir_win="$_bp"
+            ;;
+        /mnt/*)
+            _bp=$(wslpath -m "$with_branding" 2>/dev/null) && test -n "$_bp" && branding_dir_win="$_bp"
+            ;;
+        esac
+    fi
+    if ! test -d "$branding_dir_unix" ; then
         AC_MSG_ERROR([No directory $with_branding, falling back to default branding])
     else
-        AC_MSG_RESULT([$with_branding])
-        CUSTOM_BRAND_DIR="$with_branding"
+        AC_MSG_RESULT([$branding_dir_win])
+        CUSTOM_BRAND_DIR="$branding_dir_win"
         for lfile in $brand_files
         do
-            if ! test -f $with_branding/$lfile ; then
+            if ! test -f "$branding_dir_unix/$lfile" ; then
                 AC_MSG_WARN([Branded file $lfile does not exist, using the default one])
                 DEFAULT_BRAND_IMAGES="$DEFAULT_BRAND_IMAGES $lfile"
             else
@@ -15614,9 +15661,9 @@ PROGRESSFRAMECOLOR=
 PROGRESSTEXTCOLOR=
 PROGRESSTEXTBASELINE=
 
-if test "$check_for_progress" = "yes" -a -f "$with_branding/progress.conf" ; then
-    source "$with_branding/progress.conf"
-    AC_MSG_RESULT([settings found in $with_branding/progress.conf])
+if test "$check_for_progress" = "yes" -a -f "$branding_dir_unix/progress.conf" ; then
+    source "$branding_dir_unix/progress.conf"
+    AC_MSG_RESULT([settings found in $branding_dir_win/progress.conf])
 else
     AC_MSG_RESULT([none])
 fi
