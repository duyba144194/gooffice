diff --git a/solenv/gbuild/Helper.mk b/solenv/gbuild/Helper.mk
index 25bc378e3..f95c359a2 100644
--- a/solenv/gbuild/Helper.mk
+++ b/solenv/gbuild/Helper.mk
@@ -71,9 +71,16 @@ BUILDDIR_CYG := $(shell cygpath -u $(BUILDDIR))
 INSTDIR_CYG := $(shell cygpath -u $(INSTDIR))
 WORKDIR_CYG := $(shell cygpath -u $(WORKDIR))
 TARFILE_LOCATION_CYG := $(shell cygpath -u $(TARFILE_LOCATION))
+# GoOffice patch: cross builds carry extra _FOR_BUILD dirs that are not in
+# the base map, and a colon-separated list of drive-letter paths confuses
+# the Windows loader - give them the same POSIX treatment
+ifneq ($(CROSS_COMPILING),)
+INSTDIR_FOR_BUILD_CYG := $(shell cygpath -u $(INSTDIR_FOR_BUILD))
+WORKDIR_FOR_BUILD_CYG := $(shell cygpath -u $(WORKDIR_FOR_BUILD))
+endif
 
 define gb_Helper_cyg_path
-$(subst $(TARFILE_LOCATION)/,$(TARFILE_LOCATION_CYG)/,$(subst $(SRCDIR)/,$(SRCDIR_CYG)/,$(subst $(BUILDDIR)/,$(BUILDDIR_CYG)/,$(subst $(INSTDIR)/,$(INSTDIR_CYG)/,$(subst $(WORKDIR)/,$(WORKDIR_CYG)/,$(1))))))
+$(subst $(TARFILE_LOCATION)/,$(TARFILE_LOCATION_CYG)/,$(subst $(SRCDIR)/,$(SRCDIR_CYG)/,$(subst $(BUILDDIR)/,$(BUILDDIR_CYG)/,$(subst $(INSTDIR)/,$(INSTDIR_CYG)/,$(subst $(WORKDIR)/,$(WORKDIR_CYG)/,$(if $(INSTDIR_FOR_BUILD_CYG),$(subst $(INSTDIR_FOR_BUILD)/,$(INSTDIR_FOR_BUILD_CYG)/,$(subst $(WORKDIR_FOR_BUILD)/,$(WORKDIR_FOR_BUILD_CYG)/,$(1))),$(1)))))))
 endef
 
 ifneq ($(MSYSTEM),)
