diff --git a/configure.ac b/configure.ac
index d1db1b74a..06f61e204 100644
--- a/configure.ac
+++ b/configure.ac
@@ -6324,8 +6324,16 @@ if test "$cross_compiling" = "yes"; then
 
     # Don't bother having configure look for stuff not needed for the build platform anyway
     # WARNING: any option with an argument containing spaces must be handled separately (see --with-theme)
+    dnl GoOffice patch: for wsl-as-helper builds the BUILD side is Windows
+    dnl (cygwin), not the WSL kernel - without this the sub configure detects
+    dnl an x86_64-pc-linux-gnu host and demands Linux-only system libraries
+    build_side_host=""
+    if test -n "$WSL_ONLY_AS_HELPER"; then
+        build_side_host="--host=$build_cpu-pc-cygwin"
+    fi
     sub_conf_defaults=" \
         --build="$build_alias" \
+        $build_side_host \
         --disable-cairo-canvas \
         --disable-cups \
         --disable-customtarget-components \
