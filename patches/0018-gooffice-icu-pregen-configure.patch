diff --git a/external/icu/ExternalProject_icu.mk b/external/icu/ExternalProject_icu.mk
index d7b45f4c0..2d465c540 100644
--- a/external/icu/ExternalProject_icu.mk
+++ b/external/icu/ExternalProject_icu.mk
@@ -19,10 +19,14 @@ $(call gb_ExternalProject_get_state_target,icu,build) : $(gb_UnpackedTarball_wor
 
 ifeq ($(OS),WNT)
 
+# GoOffice: Windows CI runners have no WSL, and msys2 autoconf cannot run
+# from inside the gbuild recipe PATH (autom4te dies in its internal cp).
+# Ship the configure generated by autoconf 2.71 - the same toolchain the
+# local WSL build used - and copy it in instead of regenerating.
 $(call gb_ExternalProject_get_state_target,icu,build) :
 	$(call gb_Trace_StartRange,icu,EXTERNAL)
 	$(call gb_ExternalProject_run,build,\
-		$(WSL) autoconf -f \
+		cp -f $(SRCDIR)/generated/icu-configure ./configure \
 		&& export CC="$(filter-out -fsanitize%,$(CC))" CXX="$(filter-out -fsanitize%,$(CXX))" \
 			LIB="$(ILIB)" PYTHONWARNINGS="default" \
 			gb_ICU_XFLAGS="-FS $(SOLARINC) $(gb_DEBUGINFO_FLAGS) $(if $(MSVC_USE_DEBUG_RUNTIME),-MDd,-MD -Gy)" \
