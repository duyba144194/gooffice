diff --git a/external/libgpg-error/ExternalProject_libgpg-error.mk b/external/libgpg-error/ExternalProject_libgpg-error.mk
index 88b9b2be5..f8ee9ff2a 100644
--- a/external/libgpg-error/ExternalProject_libgpg-error.mk
+++ b/external/libgpg-error/ExternalProject_libgpg-error.mk
@@ -16,11 +16,16 @@ $(eval $(call gb_ExternalProject_register_targets,libgpg-error,\
 $(eval $(call gb_ExternalProject_use_autoconf,libgpg-error,build))
 
 ifeq ($(COM),MSC)
+# GoOffice: CONFIG_SITE=/dev/null above - msys2's /usr/local/etc/config.site
+# blanks the default prefix, so the generated gpg-error-config prints -L/lib
+# while gpgrt-config omits -L for system dirs and the
+# "Confirm gpg-error-config works" self-test fails. Git Bash (local builds)
+# has no such file and passes with prefix=/usr/local -> skip it for parity.
 $(call gb_ExternalProject_get_state_target,libgpg-error,build): $(call gb_Executable_get_target_for_build,cpp)
 	$(call gb_Trace_StartRange,libgpg-error,EXTERNAL)
 	$(call gb_ExternalProject_run,build,\
 		$(gb_WIN_GPG_cross_setup_exports) \
-		&& MAKE=$(MAKE) $(gb_RUN_CONFIGURE) ./configure \
+		&& MAKE=$(MAKE) CONFIG_SITE=/dev/null $(gb_RUN_CONFIGURE) ./configure \
 			--enable-static \
 			--disable-shared \
 			--disable-rpath \
