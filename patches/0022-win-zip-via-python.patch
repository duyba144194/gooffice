--- a/bin/gooffice-pyzip.py
+++ b/bin/gooffice-pyzip.py
@@ -0,0 +1,46 @@
+# -*- tab-width: 4; indent-tabs-mode: nil; py-indent-offset: 4 -*-
+#
+# This Source Code Form is subject to the terms of the Mozilla Public
+# License, v. 2.0. If a copy of the MPL was not distributed with this
+# file, You can obtain one at http://mozilla.org/MPL/2.0/.
+#
+# GoOffice: replacement for the "zip -q0X --filesync --must-match $@ mimetype
+# && zip -qrX --must-match $@ <files>" pairs used by the extras custom
+# targets (autocorr, autotext, templates). On the msys2 CI hosts the POSIX
+# zip mishandles the wsl_path-converted output path and dies with
+# "zip I/O error: No such file or directory"; the recipes already run a
+# working python next to zip, so zip via stdlib zipfile is the parity fix.
+#
+# Usage: gooffice-pyzip.py <output.zip> <stored-entry> <deflated-entry>...
+# Creates the archive from scratch (CI never does incremental zip updates),
+# stored entry first (ODF "mimetype" convention), deflate for the rest,
+# fixed timestamps for reproducible output.
+#
+# vim: set noet sw=4 ts=4:
+
+import sys
+import zipfile
+
+
+def _add(zf, name, compress_type):
+    info = zipfile.ZipInfo(name, date_time=(1980, 1, 1, 0, 0, 0))
+    info.compress_type = compress_type
+    info.external_attr = 0o644 << 16
+    with open(name, "rb") as f:
+        zf.writestr(info, f.read())
+
+
+def main(argv):
+    if len(argv) < 3:
+        sys.stderr.write(
+            "usage: gooffice-pyzip.py output.zip stored-entry [deflated-entry ...]\n")
+        return 2
+    with zipfile.ZipFile(argv[1], "w") as zf:
+        _add(zf, argv[2], zipfile.ZIP_STORED)
+        for name in argv[3:]:
+            _add(zf, name, zipfile.ZIP_DEFLATED)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
