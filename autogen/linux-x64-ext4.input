# GoOffice — autogen.input for Linux amd64 (WSL ext4 build at ~/core)
# Same as linux-x64.input but source lives inside WSL ext4 (fixes libffi/9p issues)

--with-help=html
--without-helppack-integration
--with-myspell-dicts
--with-fonts
--enable-extension-integration
--enable-scripting-beanshell
--enable-scripting-javascript
--enable-ext-nlpsolver
--enable-dbus
--enable-gtk3
--enable-gstreamer-1-0
--enable-gio
--enable-python=internal
--with-package-format=deb
--disable-online-update
--disable-lto
--enable-epm
--enable-release-build
--with-external-tar=/mnt/c/Users/NAM/GoOffice/lo-externaltar
--with-ant-home=/mnt/c/Users/NAM/lo/apache-ant-1.10.17
--with-junit=/mnt/c/Users/NAM/lo/junit-4.10.jar

# --- GoOffice branding ---
--with-product-name=GoOffice
--with-vendor=GoOffice Project
--with-package-version=1.0.0.0
--with-branding=/mnt/c/Users/NAM/Desktop/office/branding
--with-macosx-bundle-identifier=org.gooffice.script
--with-extra-buildid=GoOffice 1.0.0 (LibreOffice 26.8.2)
